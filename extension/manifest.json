{
  "manifest_version": 3,
  "name": "MeowlChess — Free Post-Game Analysis",
  "description": "Review completed Chess.com, Lichess, and imported PGN games locally with Stockfish or Lozza. Free, with no account needed.",
  "version": "1.7.0",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.chess.com/*",
    "https://lichess.org/api/games/user/*",
    "https://lichess.org/game/export/*"
  ],
  "action": {
    "default_title": "Open MeowlChess",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.chess.com https://lichess.org; worker-src 'self'"
  },
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "site-summary.html",
        "icons/icon48.png"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*"
      ]
    }
  ],
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
