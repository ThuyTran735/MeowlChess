{
  "name": "meowlchess",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Local reviews of completed Chess.com, Lichess, and imported PGN games",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:extension": "node tests/extension.mjs",
    "package": "node scripts/package.mjs",
    "test:features": "node tests/features.mjs",
    "test:ui": "node tests/ui-polish.mjs",
    "test:performance": "node tests/game-performance-ui.mjs",
    "test:reviewed": "node tests/reviewed-games-ui.mjs",
    "test:imports": "node tests/import-ui.mjs",
    "test:tutorial": "node tests/tutorial-ui.mjs",
    "test:notation": "node tests/move-notation-ui.mjs",
    "test:usernames": "node tests/username-persistence-ui.mjs",
    "test:site-review": "node tests/site-review-ui.mjs",
    "test:site-bot": "node tests/site-bot-ui.mjs",
    "test:site-panel": "node tests/site-panel-ui.mjs",
    "test:site-panel-extension": "node tests/site-panel-extension.mjs",
    "test:qol": "node tests/qol-ui.mjs",
    "test:sharing": "node tests/summary-share-ui.mjs",
    "test:site-retry": "node tests/site-retry-ui.mjs",
    "test:alerts": "node tests/completion-alerts-ui.mjs",
    "test:board-qol": "node tests/board-qol-ui.mjs",
    "test:accounts": "node tests/accounts-ui.mjs",
    "test:sounds": "node tests/move-sounds-ui.mjs"
