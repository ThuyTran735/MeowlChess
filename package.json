{
  "name": "meowlchess",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "description": "Local reviews of completed Chess.com, Lichess, and imported PGN games",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:extension": "node tests/extension.mjs",
    "package": "node scripts/package.mjs",
    "test:features": "node tests/features.mjs",
    "test:imports": "node tests/import-ui.mjs",
    "test:tutorial": "node tests/tutorial-ui.mjs",
    "test:site-review": "node tests/site-review-ui.mjs",
    "test:site-bot": "node tests/site-bot-ui.mjs",
    "test:site-panel": "node tests/site-panel-ui.mjs",
    "test:site-panel-extension": "node tests/site-panel-extension.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "stockfish": "18.0.5"
  },
  "devDependencies": {
    "playwright-core": "1.56.1"
  }
}
